
name: Build Noctis Client

on:
  workflow_dispatch:
  push:
    paths:
      - "noctis-client-complete-1.zip"
      - ".github/workflows/noctis-build.yml"

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Java 21
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "21"

      - name: Install unzip
        run: sudo apt-get update && sudo apt-get install -y unzip

      - name: Extract Noctis project
        shell: bash
        run: |
          ZIP="noctis-client-complete-1.zip"
          if [ ! -f "$ZIP" ]; then
            echo "ERROR: Upload $ZIP to the repository root first."
            ls -la
            exit 1
          fi
          mkdir -p extracted
          unzip -q "$ZIP" -d extracted

      - name: Build Fabric client
        shell: bash
        run: |
          WRAPPER="$(find extracted -type f -name gradlew -print -quit)"
          if [ -z "$WRAPPER" ]; then
            echo "ERROR: No Gradle wrapper found inside the ZIP."
            find extracted -maxdepth 4 -type f | head -100
            exit 1
          fi
          PROJECT_DIR="$(dirname "$WRAPPER")"
          chmod +x "$WRAPPER"
          cd "$PROJECT_DIR"
          ./gradlew build --no-daemon

      - name: Upload JAR
        if: success()
        uses: actions/upload-artifact@v4
        with:
          name: noctis-client-jar
          path: extracted/**/build/libs/*.jar
          if-no-files-found: error
